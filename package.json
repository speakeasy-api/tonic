{
  "name": "@speakeasy/tonic",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2.5 kB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "2.5 kB"
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^12.0.0",
    "@types/bun": "latest",
    "size-limit": "^12.0.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
