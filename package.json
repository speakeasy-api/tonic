{
  "name": "tonic-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:ts",
    "build:ts": "cd packages/tonic && bun run build",
    "check": "bun run check:ts && bun run check:rust",
    "check:ts": "bun run fmt:ts:check && bun run test:ts && bun run build:ts",
    "check:rust": "bun run fmt:rust:check && bun run lint:rust && bun run test:rust",
    "fmt:ts": "prettier --write . --ignore-path .prettierignore --ignore-unknown",
    "fmt:ts:check": "prettier --check . --ignore-path .prettierignore --ignore-unknown",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test": "bun run test:ts && bun run test:rust",
    "test:ts": "cd packages/tonic && bun run test",
    "test:rust": "cargo test --workspace",
    "size": "cd packages/tonic && bun run size",
    "parity:diff": "bun tooling/parity/compare.ts",
    "release:ts": "npm publish ./packages/tonic",
    "release:ts:dry-run": "npm publish --dry-run ./packages/tonic",
    "release:rust": "bun tooling/release/publish-rust.mjs",
    "release:rust:dry-run": "bun tooling/release/publish-rust.mjs --dry-run",
    "release:all": "bun run release:rust && bun run release:ts",
    "release:all:dry-run": "bun run release:rust:dry-run && bun run release:ts:dry-run",
    "version:sync:rust": "bun tooling/release/sync-rust-version.mjs"
  },
  "devDependencies": {
    "prettier": "^3"
  }
}
